{
  "name": "security-hooks",
  "description": "MCP security scanner and protected branch hooks for Claude Code",
  "version": "1.1.1",
  "author": {
    "name": "Richard Claydon"
  },
  "license": "MPL-2.0",
  "keywords": ["security", "hooks", "mcp", "branch-protection"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/mcp-security-scanner.sh"
          }
        ]
      },
      {
        "matcher": "^(Edit|Write|Bash|Task)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/protect-main-branch.sh"
          }
        ]
      }
    ]
  }
}
